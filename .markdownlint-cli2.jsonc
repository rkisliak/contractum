// markdownlint-cli2 configuration for every Markdown file in the repository.
// Run from the repository root (CI and local):
//   docker run --rm -v "$PWD:/workdir:ro" davidanson/markdownlint-cli2:v0.24.2@sha256:c768e94d8bb161c449bde28f60656929ca1f02c3010a405f65c9cac71563a889
{
  "config": {
    "default": true,
    // Line length: prose is wrapped by hand, tables and long URLs cannot be wrapped.
    "MD013": false,
    // Inline HTML: the README logo needs <picture>, and some pages use md_in_html blocks.
    "MD033": false,
    // Table pipe spacing: purely cosmetic, and generated tables use the compact style.
    "MD060": false
    // MD024 (no duplicate headings) stays on: duplicate headings get different anchors on
    // GitHub and on the docs site, so a link to one of them breaks in one of the two.
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/.venv*/**",
    // Local development secrets, not documentation.
    ".dev/**",
    // Vendored design skills, hash-locked in skills-lock.json; local edits would break the lock.
    ".claude/skills/typeui-*/**",
    // Generated agent instructions, so hand fixes would be overwritten.
    ".claude/CLAUDE.md",
    // Test and build output.
    "ui/test-results/**",
    "ui/playwright-report/**",
    "**/dist/**",
    "site/**"
  ],
  "gitignore": true
}
