<mxCell id="c4" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Traefik" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6F3F7;strokeColor=#0891B2;strokeWidth=2;fontColor=#0F172A;fontSize=13;align=center;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;contracts service&lt;/b&gt;&lt;br&gt;1 Policy contract:publish + If-Match&lt;br&gt;2 Unlocked reads: bytes, rules, baseline, link facts&lt;br&gt;4 Lock contract row, then draft row&lt;br&gt;5 Re-check: ETag, hash, rules, SemVer, baseline, link facts&lt;br&gt;6 Draft becomes published + rule pins" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="430" y="40" width="380" height="200" as="geometry"/></mxCell>
