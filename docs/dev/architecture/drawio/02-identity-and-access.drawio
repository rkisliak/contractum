edge="1" parent="1" source="tree-6" target="tree-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tree-21" value="" style="html=1;strokeColor=#475569;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=none;" edge="1" parent="1" source="tree-7" target="tree-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tree-22" value="" style="html=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="tree-12" target="tree-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tree-23" value="✕ never sideways" style="html=1;strokeColor=#DC2626;strokeWidth=2;fontColor=#475569;fontSize=13;curved=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="tree-3" target="tree-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tree-24" value="✕ never upward" style="html=1;strokeColor=#DC2626;strokeWidth=2;fontColor=#475569;fontSize=13;curved=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="tree-3" target="tree-2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tree-25" value="1" style="ellipse;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="39" y="99" width="26" height="26" as="geometry"/></mxCell><mxCell id="tree-26" value="2" style="ellipse;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="317" y="257" width="26" height="26" as="geometry"/></mxCell><mxCell id="tree-27" value="3" style="ellipse;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="717" y="249" width="26" height="26" as="geometry"/></mxCell><mxCell id="tree-28" value="① A role is granted on one folder, to a user, a group or a machine identity, at its own level.&lt;br&gt;② It applies to that folder and every folder below it.&lt;br&gt;③ It never reaches a parent or a sibling: Marketing answers 404, as if it did not exist.&lt;br&gt;A block flag on an Organization or Team cuts grants made above it (except Global admin)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F4F6F8;strokeColor=#94A3B8;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1120" height="104" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
