{
  "name": "contractum-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --check .",
    "gen:api": "openapi-typescript openapi/openapi.json -o src/api/schema.gen.ts",
    "gen:api:check": "node scripts/gen-api-check.mjs",
    "ci:static": "pnpm gen:api:check && pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:coverage": "vitest run --coverage",
    "ci:full": "pnpm gen:api:check && pnpm format && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@azure/msal-browser": "5.29.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/saira": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.70.0",
    "monaco-editor": "0.57.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "msw": "3.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
