<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" compressed="false"><diagram id="p1" name="Mandatory inheritance"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Mandatory inheritance: which rule sets apply where" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Platform scope (no folder, applies to every contract)&lt;/b&gt;&lt;br&gt;odcs-structural v1 &lt;b style="color:#059669"&gt;ENFORCE&lt;/b&gt; &amp;nbsp;·&amp;nbsp; odcs-consistency v1 &lt;b style="color:#D97706"&gt;WARN&lt;/b&gt; &amp;nbsp;·&amp;nbsp; odcs-references v1 &lt;b style="color:#D97706"&gt;WARN&lt;/b&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1120" height="70" as="geometry"/></mxCell><mxCell id="c5" value="1" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1147" y="57" width="26" height="26" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;ROOT&lt;/b&gt;&lt;br&gt;no folder sets here" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="450" y="180" width="300" height="56" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Organization · acme&lt;/b&gt; (mandatory here)&lt;br&gt;org-naming v3 &lt;b style="color:#059669"&gt;ENFORCE&lt;/b&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="380" y="276" width="440" height="80" as="geometry"/></mxCell><mxCell id="c8" value="2" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="807" y="263" width="26" height="26" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Project A · payments&lt;/b&gt; (mandatory here)&lt;br&gt;pii-policy v1 &lt;b style="color:#059669"&gt;ENFORCE&lt;/b&gt;&lt;br&gt;pii-policy v2 (enforce_at in 9 days) &lt;b style="color:#D97706"&gt;WARN&lt;/b&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="110" y="404" width="440" height="102" as="geometry"/></mxCell><mxCell id="c10" value="3" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="537" y="391" width="26" height="26" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Project B · marketing&lt;/b&gt;&lt;br&gt;no own sets; does not see pii-policy (a sibling branch)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="404" width="380" height="72" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Team A1&lt;/b&gt; · effective rules&lt;br&gt;odcs-structural v1 &lt;b style="color:#059669"&gt;ENFORCE&lt;/b&gt;&lt;br&gt;odcs-consistency v1 &lt;b style="color:#D97706"&gt;WARN&lt;/b&gt;&lt;br&gt;odcs-references v1 &lt;b style="color:#D97706"&gt;WARN&lt;/b&gt;&lt;br&gt;org-naming v3 &lt;b style="color:#059669"&gt;ENFORCE&lt;/b&gt;&lt;br&gt;pii-policy v1 &lt;b style="color:#059669"&gt;ENFORCE&lt;/b&gt;&lt;br&gt;pii-policy v2 &lt;b style="color:#D97706"&gt;WARN&lt;/b&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="552" width="260" height="232" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Team A2&lt;/b&gt; · effective rules&lt;br&gt;odcs-structural v1 &lt;b style="color:#059669"&gt;ENFORCE&lt;/b&gt;&lt;br&gt;odcs-consistency v1 &lt;b style="color:#D97706"&gt;WARN&lt;/b&gt;&lt;br&gt;odcs-references v1 &lt;b style="color:#D97706"&gt;WARN&lt;/b&gt;&lt;br&gt;org-naming v3 &lt;b style="color:#059669"&gt;ENFORCE&lt;/b&gt;&lt;br&gt;pii-policy v1 &lt;b style="color:#059669"&gt;ENFORCE&lt;/b&gt;&lt;br&gt;pii-policy v2 &lt;b style="color:#D97706"&gt;WARN&lt;/b&gt;&lt;br&gt;team-extra v1 &lt;b style="color:#059669"&gt;ATTACHED&lt;/b&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="552" width="260" height="262" as="geometry"/></mxCell><mxCell id="c14" value="4" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="597" y="539" width="26" height="26" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;Team B1&lt;/b&gt; · effective rules&lt;br&gt;odcs-structural v1 &lt;b style="color:#059669"&gt;ENFORCE&lt;/b&gt;&lt;br&gt;odcs-consistency v1 &lt;b style="color:#D97706"&gt;WARN&lt;/b&gt;&lt;br&gt;odcs-references v1 &lt;b style="color:#D97706"&gt;WARN&lt;/b&gt;&lt;br&gt;org-naming v3 &lt;b style="color:#059669"&gt;ENFORCE&lt;/b&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="770" y="552" width="260" height="172" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="enforced &lt;b&gt;ENFORCE&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="800" y="180" width="170" height="26" as="geometry"/></mxCell><mxCell id="c23" value="error findings block" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="984" y="183" width="180" height="24" as="geometry"/></mxCell><mxCell id="c24" value="in grace &lt;b&gt;WARN&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBF0E6;strokeColor=#D97706;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="214" width="170" height="26" as="geometry"/></mxCell><mxCell id="c25" value="reported, never blocks" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="984" y="217" width="180" height="24" as="geometry"/></mxCell><mxCell id="c26" value="Team A2 attaches team-extra to one contract: an attachment adds rules, it never removes a mandatory one." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="826" width="900" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Sandbox"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="The rule sandbox: rules never run in the web process" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;contracts: publish run&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="200" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;contracts: save run&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="200" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;validate on demand&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="200" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;rule-set check&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="200" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;validation web process&lt;/b&gt; (never imports the CEL engine)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="280" y="96" width="540" height="520" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Run slots&lt;/b&gt;&lt;br&gt;max 4 runs at once&lt;br&gt;(DC_MAX_CONCURRENT_RUNS)&lt;br&gt;&lt;br&gt;slot 1 · slot 2 · slot 3 · slot 4&lt;br&gt;&lt;br&gt;waits at most DC_QUEUE_WAIT_S (2 s)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="200" height="270" as="geometry"/></mxCell><mxCell id="c10" value="1" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="487" y="127" width="26" height="26" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;No slot in time:&lt;/b&gt;&lt;br&gt;&lt;b style="color:#DC2626"&gt;503 validation-unavailable&lt;/b&gt;&lt;br&gt;Retry-After: 1' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE9E9;strokeColor=#DC2626;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="446" width="200" height="66" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Clock watcher&lt;/b&gt;&lt;br&gt;Per rule: DC_RULE_TIMEOUT_MS = 500&lt;br&gt;measured in worker CPU time (/proc)&lt;br&gt;Hard wall cap: 8 x the timeout&lt;br&gt;Per run: DC_RUN_BUDGET_S = 5&lt;br&gt;leftover rules: run_budget_exceeded" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="530" y="140" width="270" height="150" as="geometry"/></mxCell><mxCell id="c13" value="3" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="787" y="127" width="26" height="26" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Report builder&lt;/b&gt;&lt;br&gt;pass / fail / error for every rule&lt;br&gt;fixed text per error code&lt;br&gt;no document values copied&lt;br&gt;nothing is ever skipped" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="530" y="430" width="270" height="136" as="geometry"/></mxCell><mxCell id="c15" value="5" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="787" y="417" width="26" height="26" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Worker 1&lt;/b&gt;&lt;br&gt;python -m dc_rules.worker&lt;br&gt;CEL engine + JSONPath&lt;br&gt;RLIMIT_AS 1 GiB, RLIMIT_CPU&lt;br&gt;no network, no database&lt;br&gt;recycled after 200 jobs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="260" height="140" as="geometry"/></mxCell><mxCell id="c17" value="2" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1147" y="117" width="26" height="26" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Worker 2: killed&lt;/b&gt; when a rule uses its CPU time (that rule becomes timeout).&lt;br&gt;A &lt;b&gt;fresh Worker 2&lt;/b&gt; is spawned and takes the remaining rules. A worker that dies before its first rule is retried once." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE9E9;strokeColor=#DC2626;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="900" y="330" width="260" height="140" as="geometry"/></mxCell><mxCell id="c19" value="4" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1147" y="317" width="26" height="26" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;dashed=1;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="JSON lines" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;" edge="1" parent="1" source="c9" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="JSON lines" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;" edge="1" parent="1" source="c9" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;dashed=1;" edge="1" parent="1" source="c16" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;dashed=1;" edge="1" parent="1" source="c18" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="report back to the caller" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;dashed=1;" edge="1" parent="1" source="c14" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="1 Queue for a slot · 2 A worker evaluates · 3 The parent watches the clock · 4 Kill and respawn · 5 Results return" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1120" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="Dry run"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Rule dry run: what would this rule set block?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Policy Manager&lt;/b&gt;&lt;br&gt;rule_set_id, version" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDEDFC;strokeColor=#4F46E5;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;contracts&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="270" y="90" width="300" height="470" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;POST /api/v1/contracts/governance/rule-set-dry-runs&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="290" y="130" width="260" height="70" as="geometry"/></mxCell><mxCell id="c7" value="1" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="537" y="117" width="26" height="26" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Keyset page of Latest versions&lt;/b&gt;&lt;br&gt;page 1 · contracts 1 to 25&lt;br&gt;page 2 · next_cursor&lt;br&gt;page 3 · next_cursor" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="290" y="220" width="260" height="150" as="geometry"/></mxCell><mxCell id="c9" value="2" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="537" y="207" width="26" height="26" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Filter by the caller's scope&lt;/b&gt;&lt;br&gt;names need contract:read-metadata (otherwise hidden)&lt;br&gt;pointers need contract:read (otherwise pointers_withheld)&lt;br&gt;&lt;b&gt;answer: items, summary, next_cursor, total_in_scope&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="290" y="390" width="260" height="154" as="geometry"/></mxCell><mxCell id="c11" value="5" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="537" y="377" width="26" height="26" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;validation&lt;/b&gt; (internal routes)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="630" y="90" width="280" height="470" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;GET /api/v1/validation/rule-sets/{id}&lt;/b&gt;: the folder" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="650" y="130" width="240" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;POST /internal/v1/validation/rule-sets/{id}/dry-run&lt;/b&gt;&lt;br&gt;caps checked first: 25 items, 20 folders, 4 MiB&lt;br&gt;PDP check of every distinct item folder, inside the scope" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="650" y="220" width="240" height="150" as="geometry"/></mxCell><mxCell id="c15" value="3" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="877" y="207" width="26" height="26" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Batch slot, then sandbox&lt;/b&gt;&lt;br&gt;smaller pool than the workers, so publishes are never starved&lt;br&gt;run slot per document only&lt;br&gt;page clock before each one: page budget, caller still there?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="650" y="390" width="240" height="150" as="geometry"/></mxCell><mxCell id="c17" value="4" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="877" y="377" width="26" height="26" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;identity PDP&lt;/b&gt;&lt;br&gt;permission and scope checks with the caller's bearer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="90" width="200" height="80" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;Page result&lt;/b&gt;&lt;br&gt;returned to the caller&lt;br&gt;&lt;br&gt;orders: &lt;b style="color:#DC2626"&gt;would block&lt;/b&gt;&lt;br&gt;users: &lt;b style="color:#059669"&gt;pass&lt;/b&gt;&lt;br&gt;billing: &lt;b style="color:#DC2626"&gt;would block&lt;/b&gt;&lt;br&gt;(hidden): &lt;b style="color:#059669"&gt;pass&lt;/b&gt;&lt;br&gt;events: &lt;b style="color:#D97706"&gt;rule error&lt;/b&gt;&lt;br&gt;&lt;br&gt;would_fail 2 · would_error 1&lt;br&gt;pass 2 · hidden 1' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDEFF2;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="190" width="200" height="290" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;audit&lt;/b&gt;&lt;br&gt;governance.rule_set_dry_run&lt;br&gt;counts only, one per page" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBF0E6;strokeColor=#D97706;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="500" width="200" height="80" as="geometry"/></mxCell><mxCell id="c21" value="6" style="ellipse;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1147" y="487" width="26" height="26" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontFamily=Helvetica;fontColor=#0F172A;fontSize=13;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;