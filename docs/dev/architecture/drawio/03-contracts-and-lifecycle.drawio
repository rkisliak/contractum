<mxCell id="c4" value="&lt;b&gt;Draft&lt;/b&gt;&lt;br&gt;state = draft&lt;br&gt;editable, ETag r&amp;lt;revision&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontSize=13;align=center;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="260" y="250" width="190" height="100" as="geometry"/></mxCell>
