<mxCell id="c9" value="&lt;b&gt;Deprecated&lt;/b&gt; is a flag, not a state:&lt;br&gt;POST versions/{ref}/deprecate sets it with a sunset date on any published version.&lt;br&gt;Promote clears it. Fetches carry Deprecation and Sunset headers." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FBF2E6;strokeColor=#D97706;strokeWidth=2;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="570" y="420" width="370" height="90" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Unpublished&lt;/b&gt;&lt;br&gt;hidden from consumers&lt;br&gt;owners still see it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDEEF0;strokeColor=#475569;strokeWidth=2;fontColor=#0F172A;fontSize=13;align=center;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1010" y="300" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;Soft-deleted contract&lt;/b&gt;&lt;br&gt;DELETE /contracts/{id}&lt;br&gt;POST /contracts/{id}/restore&lt;br&gt;guards: contract-referenced, contract-pinned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#94A3B8;strokeWidth=2;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="300" height="100" as="geometry"/></mxCell>
