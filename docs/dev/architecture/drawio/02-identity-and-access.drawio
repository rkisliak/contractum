<mxfile host="app.diagrams.net" type="device"><diagram id="auth" name="Auth flow"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="auth-1" value="How one API call is authenticated and authorized" style="text;html=1;align=center;verticalAlign=middle;fontColor=#0F172A;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="15" width="600" height="30" as="geometry"/></mxCell><mxCell id="auth-2" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;user, pipeline, SDK&lt;br&gt;Bearer token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDEDFC;strokeColor=#4F46E5;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="150" height="90" as="geometry"/></mxCell><mxCell id="auth-3" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Traefik: routes, TLS, rate limit&lt;br&gt;&lt;i&gt;no authentication&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E6F4F7;strokeColor=#0891B2;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="160" width="140" height="90" as="geometry"/></mxCell><mxCell id="auth-4" value="&lt;b&gt;Any service&lt;/b&gt;&lt;br&gt;contracts, validation, audit, mail, identity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F7FAFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="330" height="390" as="geometry"/></mxCell><mxCell id="auth-5" value="&lt;b&gt;authenticate()&lt;/b&gt;&lt;br&gt;JWT: issuer registry + JWKS key&lt;br&gt;dcp_ token: ask identity who it is" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="165" width="290" height="80" as="geometry"/></mxCell><mxCell id="auth-6" value="&lt;b&gt;require(permission, target)&lt;/b&gt;&lt;br&gt;declared on every route of a PolicyRouter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="290" height="75" as="geometry"/></mxCell><mxCell id="auth-7" value="&lt;b&gt;Handler runs, or a problem&lt;/b&gt;&lt;br&gt;ALLOW: 2xx · NOT_FOUND: 404&lt;br&gt;FORBIDDEN: 403 · no answer: 503" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F0FD;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="390" width="290" height="80" as="geometry"/></mxCell><mxCell id="auth-8" value="&lt;b&gt;identity: the decision point (PDP)&lt;/b&gt;&lt;br&gt;POST /internal/v1/authz/check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBF9FF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="370" height="390" as="geometry"/></mxCell><mxCell id="auth-9" value="&lt;b&gt;PrincipalGate&lt;/b&gt;&lt;br&gt;is the caller live and admitted?&lt;br&gt;Entra: Microsoft Graph via 60 s cache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="165" width="330" height="80" as="geometry"/></mxCell><mxCell id="auth-10" value="&lt;b&gt;LocalAuthorizer decides&lt;/b&gt;&lt;br&gt;roles on the folder and its ancestors, direct or through groups" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="280" width="330" height="75" as="geometry"/></mxCell><mxCell id="auth-11" value="&lt;b&gt;Not ALLOW? Record it first&lt;/b&gt;&lt;br&gt;one check.denied outbox row, committed before the answer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FCEAEA;strokeColor=#DC2626;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="390" width="330" height="80" as="geometry"/></mxCell><mxCell id="auth-12" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;identity DB: outbox" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDEEF0;strokeColor=#475569;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="140" height="64" as="geometry"/></mxCell><mxCell id="auth-13" value="&lt;b&gt;NATS&lt;/b&gt;&lt;br&gt;AUDIT stream" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F6ED;strokeColor=#16A34A;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="925" y="560" width="115" height="64" as="geometry"/></mxCell><mxCell id="auth-14" value="&lt;b&gt;audit&lt;/b&gt;&lt;br&gt;category denial" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBF2E6;strokeColor=#D97706;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1065" y="560" width="115" height="64" as="geometry"/></mxCell><mxCell id="auth-15" value="subject audit.identity.authz.check.denied (relayed after commit)" style="text;html=1;align=center;verticalAlign=middle;fontColor=#475569;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="630" width="420" height="24" as="geometry"/></mxCell><mxCell id="auth-16" value="" style="html=1;strokeColor=#0F172A;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-2" target="auth-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-17" value="" style="html=1;strokeColor=#0F172A;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-3" target="auth-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-18" value="" style="html=1;strokeColor=#0F172A;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-5" target="auth-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-19" value="" style="html=1;strokeColor=#0F172A;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-6" target="auth-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-20" value="dcp_ only" style="html=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-5" target="auth-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-21" value="check / decision" style="html=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-6" target="auth-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-22" value="" style="html=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-9" target="auth-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-23" value="" style="html=1;strokeColor=#DC2626;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-10" target="auth-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-24" value="" style="html=1;strokeColor=#DC2626;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-11" target="auth-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-25" value="" style="html=1;strokeColor=#475569;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-12" target="auth-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-26" value="" style="html=1;strokeColor=#16A34A;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-13" target="auth-14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-27" value="answer to the client" style="html=1;strokeColor=#0F172A;strokeWidth=2;fontColor=#475569;fontSize=13;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-7" target="auth-2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auth-28" value="1" style="ellipse;html=1;fillColor=#4F46E5;strokeColor=#4F46E5;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="31" y="147" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-29" value="2" style="ellipse;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="421" y="152" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-30" value="3" style="ellipse;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="421" y="267" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-31" value="4" style="ellipse;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="821" y="152" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-32" value="5" style="ellipse;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="821" y="267" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-33" value="6" style="ellipse;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="821" y="377" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-34" value="7" style="ellipse;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="421" y="377" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-35" value="&lt;b&gt;What the caller sees&lt;/b&gt;&lt;br&gt;ALLOW: the handler runs (2xx)&lt;br&gt;NOT_FOUND: 404 not-found, the target is hidden&lt;br&gt;FORBIDDEN: 403 forbidden, visible but not allowed&lt;br&gt;unavailable: 503 service-unavailable" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F4F6F8;strokeColor=#94A3B8;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="650" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tree" name="Folder hierarchy"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tree-1" value="Grants flow down the folder tree, never up or sideways" style="text;html=1;align=center;verticalAlign=middle;fontColor=#0F172A;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="15" width="600" height="30" as="geometry"/></mxCell><mxCell id="tree-2" value="&lt;b&gt;ROOT&lt;/b&gt;&lt;br&gt;global roles live here" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F4F6F8;strokeColor=#94A3B8;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="100" width="180" height="56" as="geometry"/></mxCell><mxCell id="tree-3" value="&lt;b&gt;Organization: Finance&lt;/b&gt;&lt;br&gt;org_admin granted here" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E5DAFB;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="200" width="200" height="56" as="geometry"/></mxCell><mxCell id="tree-4" value="&lt;b&gt;Organization: Marketing&lt;/b&gt;&lt;br&gt;no access" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F4F6F8;strokeColor=#94A3B8;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="770" y="200" width="200" height="56" as="geometry"/></mxCell><mxCell id="tree-5" value="&lt;b&gt;Project: Payments&lt;/b&gt;&lt;br&gt;inherited" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="115" y="320" width="170" height="56" as="geometry"/></mxCell><mxCell id="tree-6" value="&lt;b&gt;Project: Ledger&lt;/b&gt;&lt;br&gt;inherited" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="375" y="320" width="170" height="56" as="geometry"/></mxCell><mxCell id="tree-7" value="&lt;b&gt;Project: Campaigns&lt;/b&gt;&lt;br&gt;no access" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F4F6F8;strokeColor=#94A3B8;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="785" y="320" width="170" height="56" as="geometry"/></mxCell><mxCell id="tree-8" value="&lt;b&gt;Team: Cards&lt;/b&gt;&lt;br&gt;inherited" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="160" height="56" as="geometry"/></mxCell><mxCell id="tree-9" value="&lt;b&gt;Team: Fraud&lt;/b&gt;&lt;br&gt;inherited" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="195" y="440" width="160" height="56" as="geometry"/></mxCell><mxCell id="tree-10" value="&lt;b&gt;Team: Close&lt;/b&gt;&lt;br&gt;inherited" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F2ECFD;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="440" width="160" height="56" as="geometry"/></mxCell><mxCell id="tree-11" value="&lt;b&gt;Team: Web&lt;/b&gt;&lt;br&gt;no access" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F4F6F8;strokeColor=#94A3B8;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="790" y="440" width="160" height="56" as="geometry"/></mxCell><mxCell id="tree-12" value="&lt;b&gt;grant&lt;/b&gt;&lt;br&gt;org_admin → finance-admins" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9E0FC;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x=