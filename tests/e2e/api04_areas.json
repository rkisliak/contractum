      {"method": "GET", "path": "/api/v1/contracts/contracts/{contract_id}/versions/{ref}/validation-report", "kind": "read", "permission": "contract:read-published"}
    ],
    "audit queries": [
      {"method": "GET", "path": "/api/v1/audit/events", "kind": "read", "permission": "audit:list"},
